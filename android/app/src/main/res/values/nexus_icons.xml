<?xml version="1.0" encoding="utf-8"?>
<!-- The two launcher backgrounds. They are the page colours from the design
     tokens, so an adaptive icon's background layer matches the mark it sits
     behind: light #FAFAF8, dark #111113.

     The foreground layers are the user's logo — assets/logo.png for the light
     variant and assets/logo_dark.png for the dark one — copied into
     mipmap-*/ic_launcher_{light,dark}_foreground.png from the foregrounds
     flutter_launcher_icons renders during its two runs.

     The square (pre-API-26) icons are written by `dart run
     flutter_launcher_icons` (light) and `dart run flutter_launcher_icons -f
     dark_icons.yaml` (dark). Those runs also rewrite the adaptive-icon XML and
     the manifest's icon lines to point at one shared artwork; the two runs are
     reconciled afterwards so each alias keeps its own mark and background —
     see test/launcher_icons_test.dart. -->
<resources>
    <color name="nexus_icon_light_background">#FAFAF8</color>
    <color name="nexus_icon_dark_background">#111113</color>
</resources>
