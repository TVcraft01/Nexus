<?xml version="1.0" encoding="utf-8"?>
<!-- The two launcher backgrounds. They are the page colours from the design
     tokens, so an adaptive icon's background layer matches the mark it sits
     behind: light #FAFAF8, dark #111113.

     The foreground layers are the mesh mark — the nodes-and-edges logo, painted
     in the accent (#773DDC) — generated into
     mipmap-*/ic_launcher_{light,dark}_foreground.png, sized so the diagonal of
     the mark stays inside Android's 66 dp safe circle on an unseen mask: the
     mark is 38.89% of that 108 dp canvas, leaving a clear margin on every edge.

     The flat sources these layers and the square icons come from are
     assets/icon/icon_light.png and icon_dark.png, both 1024x1024 at the design
     token colours above. The square (pre-API-26) icons are regenerated by
     `dart run flutter_launcher_icons` (light) and
     `dart run flutter_launcher_icons -f dark_icons.yaml` (dark); those two
     runs do not write these foreground layers, which are generated separately
     from the same sources. -->
<resources>
    <color name="nexus_icon_light_background">#FAFAF8</color>
    <color name="nexus_icon_dark_background">#111113</color>
</resources>
