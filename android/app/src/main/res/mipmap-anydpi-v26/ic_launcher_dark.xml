<?xml version="1.0" encoding="utf-8"?>
<!-- The dark launcher icon on Android 8+ (API 26 uses the adaptive icon in
     this folder; older releases use mipmap-*/ic_launcher_dark.png instead).
     Shown by the .IconDark activity alias — see AndroidManifest.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/nexus_icon_dark_background" />
    <foreground android:drawable="@mipmap/ic_launcher_dark_foreground" />
</adaptive-icon>
