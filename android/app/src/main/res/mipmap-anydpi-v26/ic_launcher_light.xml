<?xml version="1.0" encoding="utf-8"?>
<!-- The light launcher icon on Android 8+ (API 26 uses the adaptive icon in
     this folder; older releases use mipmap-*/ic_launcher_light.png instead).
     Shown by the .IconLight activity alias — see AndroidManifest.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/nexus_icon_light_background" />
    <foreground android:drawable="@mipmap/ic_launcher_light_foreground" />
</adaptive-icon>
