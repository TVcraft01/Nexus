<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- The Wi-Fi switch the assistant may be asked to flip. Old Android lets an
         app change the radio with this; Android 10 and later mostly do not, so
         MainActivity checks what happened and opens the panel when the answer
         is no. The permission is still the one that makes the attempt legal. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- One screenshot, taken through the platform's own MediaProjection dialog.
         Since Android 14 a projection may only be opened from a foreground
         service of type mediaProjection, and that service needs this
         permission declared as well as the type in its manifest entry — see
         ScreenCaptureService.kt. The camera above is what the composer's photo
         button uses. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-permission android:name="android.permission.USB_PERMISSION"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <queries>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="http"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="geo"/></intent>
        <intent><action android:name="android.intent.action.INSERT"/><data android:mimeType="vnd.android.cursor.dir/event"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.APP_MUSIC"/></intent>
        <!-- The music-player intent behind the play_music action: without this
             entry, Android 11+ package visibility hides every player from the
             check, and the action would report "no app installed" on a phone
             that has one. -->
        <intent><action android:name="android.intent.action.MUSIC_PLAYER"/></intent>
    </queries>
    <!-- The three android:icon lines in this file — this one and the two
         activity aliases below — are rewritten wholesale by
         `dart run flutter_launcher_icons`, which regex-replaces every line
         that mentions android:icon with the icon name it was configured
         with. Running the dark set last therefore points all three at the
         dark mark, which silently drops the light artwork from the APK and
         gives both aliases the same icon. test/launcher_icons_test.dart
         pins all three, so a regeneration that does this fails the suite
         instead of shipping. -->
    <application
        android:label="Nexus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_light">
        <!-- The activity the app actually runs in. It deliberately carries no
             MAIN/LAUNCHER filter any more: the two launcher entries below are
             aliases of it, one per icon, and a filter here as well would put a
             second Nexus icon in the tray next to whichever alias is enabled.
             Every other filter it had — the nexus://pair link and USB
             attach — stays exactly where it was. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nexus" android:host="pair"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/device_filter"/>
        </activity>

        <!-- One launcher entry per icon. Android shows the icon of whichever
             alias is enabled, so switching the app icon at runtime is enabling
             one alias and disabling the other (see
             lib/core/services/icon_service.dart, which calls
             PackageManager.setComponentEnabledSetting on exactly these two
             names). Exactly one of them must be enabled at any moment: light
             ships enabled, dark ships disabled, or the tray would show two
             Nexus icons.

             enabled/exported/icon are per-alias attributes — they do not
             inherit from the target activity — and the alias names here are
             also the component names the Dart side switches between. -->
        <activity-alias
            android:name=".IconLight"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:label="Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- The mesh's background service is a data-sync job and nothing else.
             It used to be declared `dataSync|microphone`, because the wake-word
             loop borrowed this service's process to hold the microphone open —
             which is exactly the arrangement a store review reads as background
             recording. The microphone type is gone with the
             FOREGROUND_SERVICE_MICROPHONE permission above.

             The attribute itself has to stay, and has to keep saying `dataSync`:
             NexusSyncService promotes itself with
             FOREGROUND_SERVICE_TYPE_DATA_SYNC, and since Android 14 a service
             that calls startForeground with a type its manifest does not declare
             throws MissingForegroundServiceTypeException. Removing the whole
             attribute would not remove a microphone — it would break every
             background transfer on a modern phone.

             WakeWordAudio.kt is untouched. Without the microphone type it can no
             longer open the mic while Nexus is in the background, which is the
             behaviour this change is for; a refused AudioRecord is already
             answered as "no wake word" rather than a crash. -->
        <service
            android:name=".NexusSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- The one-frame screen capture. Its type is the whole reason it is a
             service: Android 14 throws from getMediaProjection() unless a
             mediaProjection service is already in the foreground. It stops
             itself as soon as the frame is saved, so nothing keeps mirroring
             the screen after the shutter. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>
        <receiver
            android:name=".WakeWordSilenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.nexus.nexus.WAKE_SILENCE"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false"/>
        <receiver
            android:name=".LocationFenceReceiver"
            android:exported="false"/>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updater"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/updater_paths"/>
        </provider>
        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
    <queries>
        <intent><action android:name="android.intent.action.PROCESS_TEXT"/><data android:mimeType="text/plain"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
    </queries>
</manifest>
